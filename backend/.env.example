# Copy to backend/.env and fill in. Never commit the real .env.
PORT=3000
NODE_ENV=development
# MongoDB connection string (Atlas or local), e.g. mongodb://127.0.0.1:27017/inventory
MONGODB_URI=mongodb://127.0.0.1:27017/inventory
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
# Only needed for /api/mailer (optional)
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-app-password
